{
  "name": "ethereum-dataset-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "data:prep": "node scripts/prepare-dataset.mjs",
    "data:tokens": "node scripts/prepare-tokens.mjs tokens.csv",
    "lint": "oxlint",
